---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { photos } from '../data/photos';

const featuredPhotos = photos.slice(0, 5);
---

<BaseLayout title="王敏摄影 · WANG MIN">
  <section class="hero">
    <img class="hero__image" src="/images/portfolio/mountain-bright.jpg" alt="晴空下的雪山" />
    <div class="hero__overlay"></div>
    <div class="hero__content">
      <p class="eyebrow">EMERGING PHOTOGRAPHER · CHINA</p>
      <h1>王敏</h1>
      <p class="hero__statement">在学习中观察光线，也在行走中收集人与风景相遇的瞬间。</p>
    </div>
    <a href="#selected" class="hero__scroll">向下探索 <span>↓</span></a>
  </section>

  <section class="intro" id="about">
    <p class="section-kicker">01 / ABOUT</p>
    <div><h2>用镜头慢慢学习，看见那些容易被忽略的美。</h2><p>我是王敏，一名仍在学习与探索中的初级摄影师。目前主要拍摄人像与自然风景。我喜欢自然光带来的柔和层次，也喜欢在旅行和日常里记录真实、不刻意的相遇。对我来说，摄影不是急着得到答案，而是练习更认真地观察世界。</p></div>
  </section>

  <section class="selected" id="selected">
    <div class="section-heading"><div><p class="section-kicker">02 / SELECTED WORK</p><h2>精选作品</h2></div><a class="text-link" href="/portfolio">查看全部 <span>↗</span></a></div>
    <PhotoGrid photos={featuredPhotos} featured />
  </section>

  <section class="contact" id="contact">
    <p class="section-kicker">03 / CONTACT</p>
    <h2>有故事想一起完成？</h2>
    <a class="contact__email" href="mailto:aprilofm@gmail.com">aprilofm@gmail.com <span>↗</span></a>
    <div class="contact__details"><span>微信：LINZHAO_PHOTO</span><span>Instagram：@linzhao.photo</span></div>
  </section>
</BaseLayout>
